# ActiGrid checkpointed recovery configuration
import os

os.environ["ACTIGRID_MSU_ROOT"] = "/kaggle/input/datasets/sazidul001x94/power-system-attack-dataset"
os.environ["ACTIGRID_TU_ROOT"] = "/kaggle/input/datasets/sazidul001x94/tu-delft-cyber-physical-power-system-cpps"
os.environ["ACTIGRID_WORK_DIR"] = "/kaggle/working/actigrid"

# Use full only if you want the journal-level extras.
# Conference is much faster and covers the main PES reviewer issues.
os.environ["ACTIGRID_PROFILE"] = "conference"
os.environ["ACTIGRID_DATASETS"] = "both"

# IMPORTANT: the same-backbone 10-seed experiment was already completed earlier.
# Set this to 1 so it is not repeated.
os.environ["ACTIGRID_SKIP_CONTROLLED"] = "1"
os.environ["ACTIGRID_SKIP_DQN"] = "0"
os.environ["ACTIGRID_FORCE"] = "0"

print("Recovery config set.")
Recovery config set.
from pathlib import Path
root=Path("/kaggle/working/actigrid")
for sub in ["controlled_same_backbone","reviewer_hardening"]:
    p=root/sub
    print("\n", p, "exists=", p.exists())
    if p.exists():
        files=sorted([x for x in p.rglob("*") if x.is_file()])
        print("files:", len(files))
        for x in files[-30:]:
            print(" ", x.relative_to(root), x.stat().st_size)
