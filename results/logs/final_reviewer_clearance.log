        b = base.load_tudelft_bundle(TU_ROOT)
    elif key == "msu":
        b = base.load_msu_bundle(MSU_ROOT)
    else:
        raise ValueError(key)
    joblib.dump(b, p, compress=3)
    return b

# -----------------------------------------------------------------------------
# Frozen fusion model and mask inference
# -----------------------------------------------------------------------------
def checkpoint_path(dataset_name: str, seed: int) -> Path:
    p = HARDEN_DIR / "cache" / f"{dataset_name}_hardening_fusion_seed{seed}.pt"
    if not p.exists():
        raise FileNotFoundError(p)
    return p

def load_frozen_model(base, bundle, seed: int):
    modalities = list(bundle.X)
    model = base.ActiveFusionClassifier(
        input_dims={m: bundle.X[m].shape[1] for m in modalities},
        modalities=modalities,
        num_classes=len(bundle.label_names),
        hidden=128, latent=64, dropout=0.20,
    ).to(base.CFG.device)
    obj = torch.load(checkpoint_path(bundle.name, seed), map_location=base.CFG.device, weights_only=False)
    state = obj["state"] if isinstance(obj, dict) and "state" in obj else obj
    model.load_state_dict(state, strict=True)
    model.eval()
    return model

def int_to_mask(x: int, M: int):
    return np.array([(x >> j) & 1 for j in range(M)], dtype=np.float32)

def subset_name(modalities, mask_int):
    return "+".join(m for j, m in enumerate(modalities) if (mask_int >> j) & 1)

@torch.no_grad()
def infer_mask(model, X_scaled: Dict[str,np.ndarray], modalities, idx, mask_int, device):
    idx = np.asarray(idx, int)
    M = len(modalities)
    mask_np = int_to_mask(mask_int, M)
    out_p = []
    for s in range(0, len(idx), BATCH):
        ii = idx[s:s+BATCH]
        xs = [torch.from_numpy(X_scaled[m][ii]).float().to(device) for m in modalities]
        mask = torch.from_numpy(mask_np).float().to(device)[None,:].repeat(len(ii),1)
        logits, _ = model(xs, mask)
        out_p.append(torch.softmax(logits, 1).cpu().numpy())
    return np.concatenate(out_p, axis=0)

def posterior_gap_audit(base, bundle, split, seeds=CONTROL_SEEDS):
    out_file = OUT / f"{bundle.name}_train_val_posterior_audit.csv"
    if out_file.exists() and not FORCE:
        return pd.read_csv(out_file)
    modalities = list(bundle.X)
    rows = []
    for seed in seeds:
        print(f"[posterior audit] {bundle.name} seed={seed}")
        model = load_frozen_model(base, bundle, seed)
        for mask_int in range(1, 1 << len(modalities)):
            name = subset_name(modalities, mask_int)
            vals = {}
            for split_name, idx in [
                ("train", split.train_idx), ("val", split.val_idx), ("test", split.test_idx)
            ]:
                p = infer_mask(model, split.X_scaled, modalities, idx, mask_int, base.CFG.device)
                y = bundle.y[idx]
                vals[split_name] = {
                    "entropy": float(entropy(p).mean()),
                    "confidence": float(p.max(1).mean()),
                    "ece": ece(p, y),
                    "macro_f1": float(f1_score(y, p.argmax(1), average="macro", zero_division=0)),
                }
            rows.append({
                "dataset": bundle.name, "seed": seed, "mask": name,
                "k": int(bin(mask_int).count("1")),
                "train_entropy": vals["train"]["entropy"],
                "val_entropy": vals["val"]["entropy"],
                "test_entropy": vals["test"]["entropy"],
                "train_minus_val_entropy": vals["train"]["entropy"] - vals["val"]["entropy"],
                "train_confidence": vals["train"]["confidence"],
                "val_confidence": vals["val"]["confidence"],
                "test_confidence": vals["test"]["confidence"],
                "train_minus_val_confidence": vals["train"]["confidence"] - vals["val"]["confidence"],
                "train_ece": vals["train"]["ece"],
                "val_ece": vals["val"]["ece"],
                "test_ece": vals["test"]["ece"],
                "train_macro_f1": vals["train"]["macro_f1"],
                "val_macro_f1": vals["val"]["macro_f1"],
                "test_macro_f1": vals["test"]["macro_f1"],
            })
        del model
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
    df = pd.DataFrame(rows)
    df.to_csv(out_file, index=False)
    return df

# -----------------------------------------------------------------------------
# MSU raw/hygiene loader: preserve NaN/Inf until AFTER the split
# -----------------------------------------------------------------------------
@dataclass
class RawMSU:
    X: Dict[str,np.ndarray]
    y: np.ndarray
    labels: List[str]
    groups: np.ndarray
    scenarios: np.ndarray
    feature_names: Dict[str,List[str]]
    meta: pd.DataFrame

def load_msu_raw_no_impute(base):
    p = CACHE / "msu_raw_no_impute.joblib"
    if p.exists() and not FORCE:
        return joblib.load(p)

    files = base.find_msu_files(MSU_ROOT)
    frames = []
    for f in files:
        d = base.read_msu_table(f)
        d.columns = [str(c).strip() for c in d.columns]
        d["__source_file"] = f.name
        frames.append(d)
    df = pd.concat(frames, ignore_index=True)

    lower_map = {c.lower(): c for c in df.columns}
    marker_col = lower_map.get("marker")
    if marker_col is None:
        for k in ["scenario","scenario_id","event","class","label"]:
            if k in lower_map:
                marker_col = lower_map[k]
                break
    if marker_col is None:
        raise ValueError("MSU raw audit cannot find Marker/scenario column")

    scenarios = df[marker_col].map(base.parse_msu_scenario)
    df["__scenario"] = scenarios
    df["__label_name"] = df["__scenario"].map(base.scenario_to_label_name)
    df = df[df["__label_name"].notna()].reset_index(drop=True)

    label_names = [
        "normal", "physical_fault_or_maintenance", "data_injection",
        "remote_trip", "relay_setting",
    ]
    label_to_id = {x:i for i,x in enumerate(label_names)}
    y = df["__label_name"].map(label_to_id).astype(int).to_numpy()

    exclude = {marker_col, "__source_file", "__scenario", "__label_name"}
    feature_cols = [c for c in df.columns if c not in exclude]
    numeric_cols = []
    for c in feature_cols:
        if pd.api.types.is_numeric_dtype(df[c]):
            numeric_cols.append(c)
        else:
            conv = pd.to_numeric(df[c], errors="coerce")
            if conv.notna().mean() >= 0.95:
                df[c] = conv
                numeric_cols.append(c)
    groups_cols = base.infer_msu_modalities(numeric_cols)

    X, feature_names = {}, {}
    for m, cols in groups_cols.items():
        z = df[cols].copy()
        for c in cols:
            z[c] = pd.to_numeric(z[c], errors="coerce")
        z = z.replace([np.inf, -np.inf], np.nan)
        X[m] = z.to_numpy(dtype=np.float32)
        feature_names[m] = list(cols)

    raw = RawMSU(
        X=X, y=y, labels=label_names,
        groups=df["__source_file"].astype(str).to_numpy(),
        scenarios=df["__scenario"].astype(str).to_numpy(),
        feature_names=feature_names,
        meta=df[["__source_file","__scenario","__label_name"]].copy(),
    )
    joblib.dump(raw, p, compress=3)
    return raw

def verify_msu_alignment(current_bundle, raw: RawMSU):
    if len(current_bundle.y) != len(raw.y):
        raise RuntimeError(f"MSU raw/current length mismatch {len(raw.y)} vs {len(current_bundle.y)}")
    a = current_bundle.meta["__source_file"].astype(str).to_numpy()
    if not np.array_equal(a, raw.groups):
        raise RuntimeError("MSU raw/current row order differs by source file")
    if not np.array_equal(current_bundle.y, raw.y):
        raise RuntimeError("MSU raw/current label order differs")
    print("[ok] raw MSU rows align exactly with current ActiGrid bundle")

def impute_from_train(raw_X: Dict[str,np.ndarray], train_idx):
    train_idx = np.asarray(train_idx, int)
    out, medians, affected = {}, {}, []
    for m, X in raw_X.items():
        X = np.asarray(X, np.float32)
        med = np.nanmedian(X[train_idx], axis=0)
        med = np.where(np.isfinite(med), med, 0.0).astype(np.float32)
        miss = ~np.isfinite(X)
        Xi = X.copy()
        rr, cc = np.where(miss)
        if len(rr):
            Xi[rr,cc] = med[cc]
        Xi = np.nan_to_num(Xi, nan=0.0, posinf=0.0, neginf=0.0).astype(np.float32)
        out[m] = Xi
        medians[m] = med
        affected.append(pd.DataFrame({
            "modality": m,
            "row": rr.astype(int),
            "feature_index": cc.astype(int),
        }))
    aff = pd.concat(affected, ignore_index=True) if affected else pd.DataFrame()
    return out, medians, aff

def split_name_vector(n, split):
    out = np.full(n, "unused", dtype=object)
    out[np.asarray(split.train_idx,int)] = "train"
    out[np.asarray(split.val_idx,int)] = "val"
    out[np.asarray(split.test_idx,int)] = "test"
    return out

def msu_hygiene_audit(base, current_bundle, split, raw: RawMSU):
    rows = []
    splitvec = split_name_vector(len(raw.y), split)
    for m, X in raw.X.items():
        bad = ~np.isfinite(X)
        bad_rows = bad.any(axis=1)
        for s in ["train","val","test"]:
            take = splitvec == s
            rows.append({
                "modality":m, "split":s,
                "rows":int(take.sum()),
                "rows_with_nan_or_inf":int((bad_rows & take).sum()),
                "cells_nan_or_inf":int(bad[take].sum()),
            })
    bad_df = pd.DataFrame(rows)
    bad_df.to_csv(OUT / "MSU_NAN_INF_AUDIT.csv", index=False)

    # Exact duplicate audit over all 128 numeric features, before imputation.
    full = np.concatenate([raw.X[m] for m in raw.X], axis=1)
    # Hashing keeps NaNs consistently; hash collisions are theoretically possible but negligible.
    h = pd.util.hash_pandas_object(pd.DataFrame(full), index=False).astype("uint64").to_numpy()
    d = pd.DataFrame({
        "hash": h,
        "source_file": raw.groups,
        "scenario": raw.scenarios,
        "label": raw.y,
        "split": splitvec,
    })
    g = d.groupby("hash").agg(
        n=("hash","size"),
        n_files=("source_file","nunique"),
        n_splits=("split","nunique"),
        n_labels=("label","nunique"),
    ).reset_index()
    dup = g[(g.n > 1) & (g.n_files > 1)].copy()
    cross = dup[dup.n_splits > 1].copy()
    summary = pd.DataFrame([{
        "n_rows":len(d),
        "exact_duplicate_hashes_across_files":len(dup),
        "rows_in_cross_file_duplicate_groups":int(d[d["hash"].isin(dup["hash"])].shape[0]),
        "duplicate_hashes_crossing_train_val_test":len(cross),
        "rows_in_cross_split_duplicate_groups":int(d[d["hash"].isin(cross["hash"])].shape[0]),
        "duplicate_hashes_with_conflicting_labels":int((dup.n_labels > 1).sum()),
    }])
    summary.to_csv(OUT / "MSU_DUPLICATE_AUDIT_SUMMARY.csv", index=False)
    if len(cross):
        details = d[d["hash"].isin(cross["hash"])].sort_values(["hash","source_file"])
        details.to_csv(OUT / "MSU_CROSS_SPLIT_DUPLICATE_ROWS.csv", index=False)
    return bad_df, summary

def make_bundle_with_X(base, template, X_new):
    return base.DatasetBundle(
        name=template.name,
        X={m:np.asarray(X_new[m],np.float32) for m in template.X},
        y=template.y.copy(),
        label_names=list(template.label_names),
        groups=np.asarray(template.groups).copy(),
        feature_names={m:list(template.feature_names[m]) for m in template.X},
        modality_costs=dict(template.modality_costs),
        meta=template.meta.copy(),
    )

# -----------------------------------------------------------------------------
# HGB sanity comparisons
# -----------------------------------------------------------------------------
def fit_hgb(Xtr, ytr, seed):
    sw = compute_sample_weight(class_weight="balanced", y=ytr)
    model = HistGradientBoostingClassifier(random_state=int(seed), **HGB_KW)
    model.fit(Xtr, ytr, sample_weight=sw)
    return model

def concat_X(Xdict, idx, modalities=None):
    if modalities is None:
        modalities = list(Xdict)
    return np.concatenate([Xdict[m][idx] for m in modalities], axis=1)

def save_confusion(y, pred, labels, stem):
    cm = confusion_matrix(y, pred, labels=np.arange(len(labels)))
    cmn = cm / np.maximum(cm.sum(axis=1, keepdims=True), 1)
    pd.DataFrame(cm, index=labels, columns=labels).to_csv(OUT / f"{stem}_counts.csv")
    pd.DataFrame(cmn, index=labels, columns=labels).to_csv(OUT / f"{stem}_normalized.csv")
    fig, ax = plt.subplots(figsize=(7,6))
    im = ax.imshow(cmn, vmin=0, vmax=1)
    ax.set_xticks(range(len(labels))); ax.set_yticks(range(len(labels)))
    ax.set_xticklabels(labels, rotation=45, ha="right", fontsize=8)
    ax.set_yticklabels(labels, fontsize=8)
    ax.set_xlabel("Predicted"); ax.set_ylabel("True")
    ax.set_title(stem.replace("_"," "))
    fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    fig.tight_layout()
    fig.savefig(FIG / f"{stem}.png", dpi=180)
    plt.close(fig)

def msu_hgb_sanity(current_bundle, split, raw: RawMSU):
    out_path = OUT / "MSU_HGB_PREPROCESSING_AND_SPLIT_SANITY.csv"
    if out_path.exists() and not FORCE:
        return pd.read_csv(out_path), None

    # Correct train-only imputation for the file-disjoint split.
    Xcorr, meds, affected = impute_from_train(raw.X, split.train_idx)
    affected.to_csv(OUT / "MSU_TRAIN_ONLY_IMPUTATION_AFFECTED_CELLS.csv", index=False)

    rows = []
    # Current globally imputed bundle.
    for tag, Xdict in [("current_pooled_median", current_bundle.X), ("train_only_median", Xcorr)]:
        model = fit_hgb(
            concat_X(Xdict, split.train_idx), current_bundle.y[split.train_idx],
            10042
        )
        pred = model.predict(concat_X(Xdict, split.test_idx))
        met = metric_dict(current_bundle.y[split.test_idx], pred)
        rows.append({"protocol":"file_disjoint", "preprocessing":tag, **met})
        save_confusion(current_bundle.y[split.test_idx], pred, current_bundle.label_names,
                       f"MSU_file_disjoint_{tag}_confusion")

    # Stratified random row sanity check, with train-only imputation inside this split.
    sss = StratifiedShuffleSplit(n_splits=1, test_size=0.20, random_state=42)
    tr, te = next(sss.split(np.zeros(len(raw.y)), raw.y))
    Xrow, _, _ = impute_from_train(raw.X, tr)
    model = fit_hgb(concat_X(Xrow,tr), raw.y[tr], 20042)
    pred = model.predict(concat_X(Xrow,te))
    met = metric_dict(raw.y[te], pred)
    rows.append({"protocol":"stratified_random_row_80_20", "preprocessing":"train_only_median", **met})
    save_confusion(raw.y[te], pred, raw.labels, "MSU_random_row_train_only_confusion")

    df = pd.DataFrame(rows)
    df.to_csv(out_path, index=False)
    return df, Xcorr

# -----------------------------------------------------------------------------
# Single-modality neural vs HGB diagnostic
# -----------------------------------------------------------------------------
def single_modality_diagnostic(base, bundle, split):
    out_path = OUT / f"{bundle.name}_single_modality_neural_vs_HGB.csv"
    if out_path.exists() and not FORCE:
        return pd.read_csv(out_path)

    model = load_frozen_model(base, bundle, 42)
    modalities = list(bundle.X)
    hgb_path = HARDEN_DIR / f"{bundle.name}_strong_subset_classifier_frontier.csv"
    hgb = pd.read_csv(hgb_path) if hgb_path.exists() else pd.DataFrame()
    rows = []
    for j,m in enumerate(modalities):
        mask = 1 << j
        p = infer_mask(model, split.X_scaled, modalities, split.test_idx, mask, base.CFG.device)
        nf1 = f1_score(bundle.y[split.test_idx], p.argmax(1), average="macro", zero_division=0)
        hf1 = np.nan
        if len(hgb):
            q = hgb[(hgb.split_seed.astype(int)==42) & (hgb.model=="HGB") & (hgb.subset==m)]
            if len(q):
                hf1 = float(q.iloc[0].test_macro_f1)
        rows.append({
            "dataset":bundle.name, "modality":m,
            "neural_masked_macro_f1":float(nf1),
            "HGB_subset_macro_f1":hf1,
            "HGB_minus_neural":float(hf1-nf1) if np.isfinite(hf1) else np.nan,
        })
    del model
    df = pd.DataFrame(rows)
    df.to_csv(out_path, index=False)
    return df

# -----------------------------------------------------------------------------
# Group-disjoint backbone/policy control for M1
# -----------------------------------------------------------------------------
def training_class_group_support(bundle, train_idx):
    """Summarize how many training groups contain each class."""
    train_idx = np.asarray(train_idx, int)
    groups = np.asarray(bundle.groups).astype(str)
    rows = []
    for cls in sorted(np.unique(bundle.y[train_idx]).tolist()):
        take = train_idx[bundle.y[train_idx] == int(cls)]
        gs = sorted(np.unique(groups[take]).tolist())
        rows.append({
            "dataset": bundle.name,
            "class_id": int(cls),
            "class_name": bundle.label_names[int(cls)],
            "n_rows": int(len(take)),
            "n_training_groups_with_class": int(len(gs)),
            "groups": " | ".join(gs),
        })
    return pd.DataFrame(rows)

def split_training_groups(bundle, train_idx, seed, backbone_fraction=0.70):
    """
    Create a backbone-training / policy-training holdout.

    Preferred mode
    --------------
    Group-disjoint: backbone and policy use different source groups, and both
    contain every class.

    Fallback
    --------
    If class-complete group separation is impossible (e.g. a rare class occurs
    in fewer than two training groups), use a stratified ROW-disjoint split.
    This still removes the reviewer's core same-row coupling: no row used to
    fit the fusion backbone is used to train the DQN policy. The fallback is
    recorded explicitly and must NOT be described as group-disjoint.
    """
    train_idx = np.asarray(train_idx, int)
    groups = np.asarray(bundle.groups).astype(str)
    ug = np.unique(groups[train_idx])
    rng = np.random.default_rng(50000 + int(seed))
    classes = set(np.unique(bundle.y[train_idx]).tolist())

    support = training_class_group_support(bundle, train_idx)
    group_feasible = bool((support["n_training_groups_with_class"] >= 2).all())

    if group_feasible:
        for attempt in range(5000):
            perm = rng.permutation(ug)
            n_back = max(1, min(len(ug)-1, int(round(len(ug)*backbone_fraction))))
            gb = set(perm[:n_back])
            gp = set(perm[n_back:])
            in_back = np.array([g in gb for g in groups[train_idx]], dtype=bool)
            bi = train_idx[in_back]
            pi = train_idx[~in_back]
            if (set(np.unique(bundle.y[bi]).tolist()) == classes and
                    set(np.unique(bundle.y[pi]).tolist()) == classes):
                return {
                    "backbone_idx": bi,
                    "policy_idx": pi,
                    "backbone_groups": sorted(gb),
                    "policy_groups": sorted(gp),
                    "holdout_unit": "group",
                    "group_overlap": 0,
                    "group_feasible": True,
                }

    # Fallback: stratified row-disjoint split.  This is the correct control for
    # same-row backbone/policy coupling when a class-complete group split cannot
    # be formed from the available training runs.
    sss = StratifiedShuffleSplit(
        n_splits=1,
        train_size=float(backbone_fraction),
        random_state=50000 + int(seed),
    )
    back_local, policy_local = next(
        sss.split(np.zeros(len(train_idx)), bundle.y[train_idx])
    )
    bi = train_idx[back_local]
    pi = train_idx[policy_local]

    if set(np.unique(bundle.y[bi]).tolist()) != classes:
        raise RuntimeError(f"Backbone row-holdout lost a class for {bundle.name}")
    if set(np.unique(bundle.y[pi]).tolist()) != classes:
        raise RuntimeError(f"Policy row-holdout lost a class for {bundle.name}")

    bg = sorted(np.unique(groups[bi]).tolist())
    pg = sorted(np.unique(groups[pi]).tolist())
    overlap = len(set(bg) & set(pg))
    return {
        "backbone_idx": bi,
        "policy_idx": pi,
        "backbone_groups": bg,
        "policy_groups": pg,
        "holdout_unit": "row",
        "group_overlap": int(overlap),
        "group_feasible": group_feasible,
    }

def scaled_split_for_backbone(base, bundle, backbone_idx, val_idx, test_idx):
    scalers, Xs = {}, {}
    for m, X in bundle.X.items():
        sc = StandardScaler()
        sc.fit(X[backbone_idx])
        z = sc.transform(X).astype(np.float32)
        z = np.nan_to_num(z, nan=0.0, posinf=8.0, neginf=-8.0)
        z = np.clip(z, -12, 12).astype(np.float32)
        scalers[m] = sc
        Xs[m] = z
    return base.SplitBundle(
        np.asarray(backbone_idx,int), np.asarray(val_idx,int), np.asarray(test_idx,int),
        scalers, Xs
    )

def eval_dqn(base, env, policy, idx):
    policy.eval()
    rows = []
    for i in np.asarray(idx,int):
        state = env.reset(int(i))
        acquired = []
        while True:
            valid = env.valid_actions()
            with torch.no_grad():
                q = policy(torch.from_numpy(state).float().unsqueeze(0).to(base.CFG.device))[0].cpu().numpy()
            action = base.masked_argmax(q, valid)
            if action < env.M:
                acquired.append(env.modalities[action])
            state, reward, done, info = env.step(action)
            if done:
                rows.append({
                    "sample_idx":int(i), "y_true":int(env.y[i]), "y_pred":int(info["pred"]),
                    "cost":float(env.total_cost), "steps":int(env.steps),
                    "acquired":" > ".join(acquired),
                })
                break
    df = pd.DataFrame(rows)
    met = metric_dict(df.y_true, df.y_pred)
    met.update({
        "normalized_cost":float(df.cost.mean()),
        "mean_steps":float(df.steps.mean())
    })
    return met, df

@torch.no_grad()
def precompute_mask_probs(model, X_scaled, modalities, idx, device):
    return {
        mi: infer_mask(model, X_scaled, modalities, idx, mi, device)
        for mi in range(1, 1 << len(modalities))
    }

def simulate_order(probs, y, modalities, costs, order, threshold):
    N = len(y)
    mi = 0
    es, ps, cs = [], [], []
    c = 0.0
    for a in order:
        mi |= (1 << a)
        c += float(costs[modalities[a]])
        p = probs[mi]
        es.append(entropy(p))
        ps.append(p.argmax(1))
        cs.append(c)
    E = np.stack(es,1); P = np.stack(ps,1)
    stop = E <= float(threshold)
    stop[:,-1] = True
    stage = stop.argmax(1)
    pred = P[np.arange(N),stage]
    cost = np.asarray(cs)[stage]
    met = metric_dict(y,pred)
    met.update({"normalized_cost":float(cost.mean()), "mean_steps":float((stage+1).mean())})
    return met, pred, cost, stage+1

def select_entropy_policy(val_probs, y_val, modalities, costs, target_cost):
    vals = np.concatenate([entropy(p) for p in val_probs.values()])
    thresholds = np.unique(np.r_[vals.min()-1e-9,
                                 np.quantile(vals,np.linspace(0,1,33)),
                                 vals.max()+1e-9])
    rows = []
    for order in itertools.permutations(range(len(modalities))):
        oname = ">".join(modalities[a] for a in order)
        for t in thresholds:
            met, _, _, _ = simulate_order(val_probs,y_val,modalities,costs,order,float(t))
            rows.append({"order":oname,"threshold":float(t),**met})
    df = pd.DataFrame(rows)
    feasible = df[df.normalized_cost <= float(target_cost) + 0.02].copy()
    if not len(feasible):
        df["cost_gap"] = abs(df.normalized_cost - float(target_cost))
        feasible = df[df.cost_gap <= df.cost_gap.min()+1e-12].copy()
    r = feasible.sort_values(["macro_f1","normalized_cost","order"],ascending=[False,True,True]).iloc[0]
    return r, df

def full_fusion_eval(model, X_scaled, bundle, idx, device):
    modalities = list(bundle.X)
    p = infer_mask(model,X_scaled,modalities,idx,(1<<len(modalities))-1,device)
    met = metric_dict(bundle.y[idx],p.argmax(1))
    met.update({"normalized_cost":1.0,"mean_steps":float(len(modalities))})
    return met, p.argmax(1)

def attack_ids(bundle):
    out = []
    for i,n in enumerate(bundle.label_names):
        s = n.lower()
        if "normal" in s or "fault" in s or "maintenance" in s:
            continue
        out.append(i)
    return set(out)

def attack_metrics(y, pred, bundle):
    y = np.asarray(y,int); pred=np.asarray(pred,int)
    aids = attack_ids(bundle)
    mask = np.array([v in aids for v in y])
    if not mask.any():
        return {"attack_detection_recall":np.nan,"attack_exact_recall":np.nan}
    pred_attack = np.array([v in aids for v in pred])
    return {
        "attack_detection_recall":float(pred_attack[mask].mean()),
        "attack_exact_recall":float((pred[mask]==y[mask]).mean()),
    }

def make_corrupted_X(split, bundle, modality, mode, seed=77):
    Xc = {m:arr.copy() if m==modality else arr for m,arr in split.X_scaled.items()}
    te = np.asarray(split.test_idx,int)
    aids = attack_ids(bundle)
    attack = te[np.array([bundle.y[i] in aids for i in te])]
    normal_ids = [i for i,n in enumerate(bundle.label_names) if "normal" in n.lower()]
    normal = te[np.isin(bundle.y[te], normal_ids)]
    rng = np.random.default_rng(seed)
    if mode == "zero":
        Xc[modality][attack] = 0.0
    elif mode == "noise":
        Xc[modality][attack] += rng.normal(0,2.0,size=Xc[modality][attack].shape).astype(np.float32)
        Xc[modality][attack] = np.clip(Xc[modality][attack],-12,12)
    elif mode == "mimic_normal":
        if not len(normal):
            raise RuntimeError("No normal test samples for mimicry")
        donors = rng.choice(normal,size=len(attack),replace=True)
        Xc[modality][attack] = Xc[modality][donors]
    else:
        raise ValueError(mode)
    return Xc

def eval_entropy_fixed_policy(model, X_scaled, bundle, idx, order_names, threshold, device):
    modalities=list(bundle.X)
    probs=precompute_mask_probs(model,X_scaled,modalities,idx,device)
    order=tuple(modalities.index(x) for x in order_names)
    return simulate_order(probs,bundle.y[idx],modalities,bundle.modality_costs,order,float(threshold))

def disjoint_control_for_dataset(base, template_bundle, primary_split, raw_msu=None):
    out_path = OUT / f"{template_bundle.name}_backbone_policy_holdout_control.csv"
    if out_path.exists() and not FORCE:
        return pd.read_csv(out_path)

    support = training_class_group_support(template_bundle, primary_split.train_idx)
    support.to_csv(OUT / f"{template_bundle.name}_train_class_group_support.csv", index=False)
    rows=[]
    corruption_rows=[]
    for seed in CONTROL_SEEDS:
        print("\n"+"="*90)
        print(f"DISJOINT BACKBONE/POLICY CONTROL | {template_bundle.name} | seed={seed}")
        print("="*90)
        holdout = split_training_groups(
            template_bundle, primary_split.train_idx, seed, BACKBONE_FRACTION
        )
        backbone_idx = np.asarray(holdout["backbone_idx"], int)
        policy_idx = np.asarray(holdout["policy_idx"], int)
        bgroups = holdout["backbone_groups"]
        pgroups = holdout["policy_groups"]
        holdout_unit = holdout["holdout_unit"]
        group_overlap = int(holdout["group_overlap"])
        print(
            f"[holdout] unit={holdout_unit} | backbone_rows={len(backbone_idx)} "
            f"policy_rows={len(policy_idx)} | backbone_groups={len(bgroups)} "
            f"policy_groups={len(pgroups)} | group_overlap={group_overlap}"
        )

        # For MSU, fit the imputation medians only on backbone-training rows.
        if raw_msu is not None:
            Ximp, _, _ = impute_from_train(raw_msu.X, backbone_idx)
            bundle = make_bundle_with_X(base, template_bundle, Ximp)
        else:
            bundle = template_bundle

        split = scaled_split_for_backbone(base,bundle,backbone_idx,primary_split.val_idx,primary_split.test_idx)
        set_seed(base, 80000+seed)
        model = base.train_fusion_classifier(
            bundle, split,
            model_tag=f"disjoint_{bundle.name}_{seed}"
        )

        old_lambda = float(base.CFG.acquisition_lambda)
        old_step = float(base.CFG.step_penalty)
        base.CFG.acquisition_lambda = LAMBDA
        base.CFG.step_penalty = 0.0
        env = base.ActiveEvidenceEnv(
            model, split.X_scaled, bundle.y, list(bundle.X),
            bundle.modality_costs, bundle.label_names, base.CFG.device
        )
        policy = base.train_dqn_policy(
            env, np.asarray(policy_idx,int), episodes=DQN_EPISODES,
            tag=f"disjoint_{bundle.name}_{seed}"
        )

        val_met, val_trace = eval_dqn(base,env,policy,primary_split.val_idx)
        test_met, test_trace = eval_dqn(base,env,policy,primary_split.test_idx)

        # Same-backbone entropy comparator, validation-selected at the DQN validation cost.
        modalities=list(bundle.X)
        vprobs=precompute_mask_probs(model,split.X_scaled,modalities,primary_split.val_idx,base.CFG.device)
        selected, curve = select_entropy_policy(
            vprobs,bundle.y[primary_split.val_idx],modalities,bundle.modality_costs,
            val_met["normalized_cost"]
        )
        order_names=tuple(str(selected.order).split(">"))
        tprobs=precompute_mask_probs(model,split.X_scaled,modalities,primary_split.test_idx,base.CFG.device)
        ent_test, ent_pred, ent_cost, ent_steps = simulate_order(
            tprobs,bundle.y[primary_split.test_idx],modalities,bundle.modality_costs,
            tuple(modalities.index(x) for x in order_names),float(selected.threshold)
        )
        full_met, full_pred = full_fusion_eval(model,split.X_scaled,bundle,primary_split.test_idx,base.CFG.device)

        rows += [
            {
                "dataset":bundle.name,"seed":seed,"method":"PolicyHoldout-DQN",
                "holdout_unit":holdout_unit,"group_overlap":group_overlap,
                "backbone_groups":len(bgroups),"policy_groups":len(pgroups),
                "backbone_train_rows":len(backbone_idx),"policy_train_rows":len(policy_idx),
                "val_macro_f1":val_met["macro_f1"],"val_cost":val_met["normalized_cost"],
                "test_macro_f1":test_met["macro_f1"],"test_cost":test_met["normalized_cost"],
            },
            {
                "dataset":bundle.name,"seed":seed,"method":"PolicyHoldout-OrderEntropy",
                "holdout_unit":holdout_unit,"group_overlap":group_overlap,
                "backbone_groups":len(bgroups),"policy_groups":len(pgroups),
                "backbone_train_rows":len(backbone_idx),"policy_train_rows":len(policy_idx),
                "val_macro_f1":float(selected.macro_f1),"val_cost":float(selected.normalized_cost),
                "test_macro_f1":ent_test["macro_f1"],"test_cost":ent_test["normalized_cost"],
                "order":str(selected.order),"threshold":float(selected.threshold),
            },
            {
                "dataset":bundle.name,"seed":seed,"method":"PolicyHoldout-FullFusion",
                "holdout_unit":holdout_unit,"group_overlap":group_overlap,
                "backbone_groups":len(bgroups),"policy_groups":len(pgroups),
                "backbone_train_rows":len(backbone_idx),"policy_train_rows":len(policy_idx),
                "val_macro_f1":np.nan,"val_cost":1.0,
                "test_macro_f1":full_met["macro_f1"],"test_cost":1.0,
            },
        ]

        test_trace.to_csv(OUT/f"{bundle.name}_policy_holdout_dqn_seed{seed}_test_trace.csv",index=False)
        torch.save({"state":policy.state_dict()},CACHE/f"{bundle.name}_policy_holdout_dqn_seed{seed}.pt")
        torch.save({"state":model.state_dict()},CACHE/f"{bundle.name}_policy_holdout_fusion_seed{seed}.pt")

        # Seed 42: modality-wise corruption comparison across methods.
        if seed == 42:
            clean_attack = attack_metrics(test_trace.y_true,test_trace.y_pred,bundle)
            dqn_first = test_trace.acquired.str.split(" > ").str[0].mode().iloc[0]
            ent_first = order_names[0]
            corruption_rows.append({
                "dataset":bundle.name,"seed":seed,"corruption":"clean","modality":"none",
                "method":"DQN","macro_f1":test_met["macro_f1"],"cost":test_met["normalized_cost"],
                "early_stop_rate_attack":float((test_trace.loc[test_trace.y_true.isin(attack_ids(bundle)),"steps"]==1).mean()),
                **clean_attack,
            })
            _, ep, ec, es = simulate_order(
                tprobs,bundle.y[primary_split.test_idx],modalities,bundle.modality_costs,
                tuple(modalities.index(x) for x in order_names),float(selected.threshold)
            )
            am = attack_metrics(bundle.y[primary_split.test_idx],ep,bundle)
            attack_mask=np.isin(bundle.y[primary_split.test_idx],list(attack_ids(bundle)))
            corruption_rows.append({
                "dataset":bundle.name,"seed":seed,"corruption":"clean","modality":"none",
                "method":"OrderEntropy","macro_f1":ent_test["macro_f1"],"cost":ent_test["normalized_cost"],
                "early_stop_rate_attack":float((es[attack_mask]==1).mean()), **am,
            })
            am=attack_metrics(bundle.y[primary_split.test_idx],full_pred,bundle)
            corruption_rows.append({
                "dataset":bundle.name,"seed":seed,"corruption":"clean","modality":"none",
                "method":"FullFusion","macro_f1":full_met["macro_f1"],"cost":1.0,
                "early_stop_rate_attack":np.nan, **am,
            })

            for m in modalities:
                for mode in ["zero","noise","mimic_normal"]:
                    Xc=make_corrupted_X(split,bundle,m,mode,seed=77)
                    envc=base.ActiveEvidenceEnv(
                        model,Xc,bundle.y,modalities,bundle.modality_costs,bundle.label_names,base.CFG.device
                    )
                    dm,dt=eval_dqn(base,envc,policy,primary_split.test_idx)
                    am=attack_metrics(dt.y_true,dt.y_pred,bundle)
                    attack_dt=dt[dt.y_true.isin(attack_ids(bundle))]
                    corruption_rows.append({
                        "dataset":bundle.name,"seed":seed,"corruption":mode,"modality":m,
                        "method":"DQN","macro_f1":dm["macro_f1"],"cost":dm["normalized_cost"],
                        "early_stop_rate_attack":float((attack_dt.steps==1).mean()),**am,
                        "is_method_first_modality":bool(m==dqn_first),
                    })
                    em,ep,ec,es=eval_entropy_fixed_policy(
                        model,Xc,bundle,primary_split.test_idx,order_names,float(selected.threshold),base.CFG.device
                    )
                    am=attack_metrics(bundle.y[primary_split.test_idx],ep,bundle)
                    attack_mask=np.isin(bundle.y[primary_split.test_idx],list(attack_ids(bundle)))
                    corruption_rows.append({
                        "dataset":bundle.name,"seed":seed,"corruption":mode,"modality":m,
                        "method":"OrderEntropy","macro_f1":em["macro_f1"],"cost":em["normalized_cost"],
                        "early_stop_rate_attack":float((es[attack_mask]==1).mean()),**am,
                        "is_method_first_modality":bool(m==ent_first),
                    })
                    fm,fp=full_fusion_eval(model,Xc,bundle,primary_split.test_idx,base.CFG.device)
                    am=attack_metrics(bundle.y[primary_split.test_idx],fp,bundle)
                    corruption_rows.append({
                        "dataset":bundle.name,"seed":seed,"corruption":mode,"modality":m,
                        "method":"FullFusion","macro_f1":fm["macro_f1"],"cost":1.0,
                        "early_stop_rate_attack":np.nan,**am,
                        "is_method_first_modality":False,
                    })

        base.CFG.acquisition_lambda=old_lambda
        base.CFG.step_penalty=old_step
        del model,policy,env,vprobs,tprobs
        gc.collect()
        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    df=pd.DataFrame(rows)
    df.to_csv(out_path,index=False)
    if corruption_rows:
        pd.DataFrame(corruption_rows).to_csv(
            OUT/f"{template_bundle.name}_holdout_policy_corruption_and_mimicry.csv",index=False
        )
    return df

# -----------------------------------------------------------------------------
# Optional corrected primary-MSU neural sensitivity if hygiene materially changes HGB
# -----------------------------------------------------------------------------
def corrected_primary_msu_sensitivity(base, template, primary_split, raw):
    out_path=OUT/"MSU_CORRECTED_PRIMARY_NEURAL_SENSITIVITY.csv"
    if out_path.exists() and not FORCE:
        return pd.read_csv(out_path)
    Ximp,_,_=impute_from_train(raw.X,primary_split.train_idx)
    bundle=make_bundle_with_X(base,template,Ximp)
    # Scaling fitted only on the original training files.
    split=scaled_split_for_backbone(base,bundle,primary_split.train_idx,primary_split.val_idx,primary_split.test_idx)
    rows=[]
    for seed in CONTROL_SEEDS:
        print(f"[corrected MSU primary sensitivity] seed={seed}")
        set_seed(base,90000+seed)
        model=base.train_fusion_classifier(bundle,split,model_tag=f"msu_corrected_primary_{seed}")
        old_lambda,old_step=float(base.CFG.acquisition_lambda),float(base.CFG.step_penalty)
        base.CFG.acquisition_lambda=LAMBDA;base.CFG.step_penalty=0.0
        env=base.ActiveEvidenceEnv(model,split.X_scaled,bundle.y,list(bundle.X),
                                   bundle.modality_costs,bundle.label_names,base.CFG.device)
        pol=base.train_dqn_policy(env,split.train_idx,episodes=DQN_EPISODES,
                                  tag=f"msu_corrected_primary_{seed}")
        tm,tr=eval_dqn(base,env,pol,split.test_idx)
        fm,_=full_fusion_eval(model,split.X_scaled,bundle,split.test_idx,base.CFG.device)
        rows += [
            {"seed":seed,"method":"CorrectedPrimary-DQN","macro_f1":tm["macro_f1"],"cost":tm["normalized_cost"]},
            {"seed":seed,"method":"CorrectedPrimary-FullFusion","macro_f1":fm["macro_f1"],"cost":1.0},
        ]
        base.CFG.acquisition_lambda=old_lambda;base.CFG.step_penalty=old_step
        del model,pol,env
        if torch.cuda.is_available():torch.cuda.empty_cache()
    df=pd.DataFrame(rows);df.to_csv(out_path,index=False)
    return df

# -----------------------------------------------------------------------------
# Summaries / decision report
# -----------------------------------------------------------------------------
def original_dqn_summary(dataset_name):
    p=HARDEN_DIR/f"{dataset_name}_dqn_lambda_frontier.csv"
    if not p.exists(): return pd.DataFrame()
    d=pd.read_csv(p)
    q=d[np.isclose(d["lambda"].astype(float),LAMBDA)].copy()
    return q

def write_report(results):
    lines=[
        "# ActiGrid Final Reviewer-Clearance Audit",
        "",
        "This report separates measured findings from hypotheses. No claim of equivalence is made.",
        "",
    ]

    pg=results.get("posterior",{})
    for name,df in pg.items():
        if df is None or not len(df): continue
        g=df.groupby("seed").agg(
            mean_train_minus_val_confidence=("train_minus_val_confidence","mean"),
            mean_train_minus_val_entropy=("train_minus_val_entropy","mean"),
        ).reset_index()
        lines += [f"## {name}: train-vs-validation posterior audit","```",g.to_string(index=False),"```",""]

    lines += ["## MSU preprocessing hygiene"]
    bad=results["msu_bad"]
    dup=results["msu_dup"]
    lines += ["```",bad.to_string(index=False),"```","```",dup.to_string(index=False),"```",""]
    hgb=results["msu_hgb"]
    lines += ["### MSU HGB split/preprocessing sanity","```",hgb.to_string(index=False),"```",""]

    file_cur=hgb[(hgb.protocol=="file_disjoint")&(hgb.preprocessing=="current_pooled_median")].iloc[0]
    file_fix=hgb[(hgb.protocol=="file_disjoint")&(hgb.preprocessing=="train_only_median")].iloc[0]
    row=hgb[hgb.protocol=="stratified_random_row_80_20"].iloc[0]
    delta=float(file_fix.macro_f1-file_cur.macro_f1)
    lines += [
        f"- Train-only imputation changed file-disjoint HGB Macro-F1 by {delta:+.4f}.",
        f"- Random-row sanity HGB Macro-F1: {row.macro_f1:.4f} versus corrected file-disjoint {file_fix.macro_f1:.4f}.",
        "- Interpret this as protocol sensitivity, not proof of leakage in prior papers.",
        "",
    ]

    lines += ["## Single-modality neural vs HGB"]
    for name,df in results["single"].items():
        lines += [f"### {name}","```",df.to_string(index=False),"```",""]

    if results.get("disjoint"):
        lines += ["## Backbone/policy holdout DQN control"]
        for name,df in results["disjoint"].items():
            lines += [f"### {name}","```",df.to_string(index=False),"```",""]
            old=original_dqn_summary(name)
            if len(old):
                lines += [
                    f"Original hardening DQN lambda={LAMBDA} mean Macro-F1={old.macro_f1.mean():.4f}, "
                    f"cost={old.normalized_cost.mean():.4f}.",
                    ""
                ]

    lines += ["## Automatic interpretation flags"]
    # Posterior gap flags
    for name,df in pg.items():
        if df is None or not len(df): continue
        cg=float(df.train_minus_val_confidence.mean())
        eg=float(df.train_minus_val_entropy.mean())
        flag=(cg>CONFIDENCE_GAP_FLAG) or (eg < -ENTROPY_GAP_FLAG)
        lines.append(
            f"- {name} posterior coupling flag: **{'YES' if flag else 'NO'}** "
            f"(mean train-val confidence={cg:+.4f}, entropy={eg:+.4f})."
        )
    dup_cross=int(dup.iloc[0].duplicate_hashes_crossing_train_val_test)
    lines.append(f"- MSU exact cross-split duplicate-hash groups: **{dup_cross}**.")
    lines.append(f"- MSU train-only-imputation materiality flag (|Delta HGB F1| >= {MATERIAL_HGB_DELTA}): "
                 f"**{'YES' if abs(delta)>=MATERIAL_HGB_DELTA else 'NO'}**.")
    lines += [
        "",
        "## Paper-use guidance",
        "- If the backbone/policy holdout DQN conclusion is similar to the original DQN conclusion, describe M1 as a checked sensitivity rather than a fatal protocol flaw. State whether the holdout unit was group or row.",
        "- If corrected MSU HGB differs materially, use corrected MSU preprocessing/results and do not report the pooled-imputation numbers as final.",
        "- Report MSU random-row versus file-disjoint results only as a sanity comparison; do not call random-row evaluation leakage unless overlap is directly demonstrated.",
        "- The old MSU three-file cluster-bootstrap interval is too coarse for a strong inferential claim; omit it from headline conclusions.",
        "- For the Pareto statement, write 'none of the tested DQN operating points' rather than a universal claim.",
        "- Use the already-generated sequential-HGB matched-budget table for the static-vs-sequential tree comparison.",
        "",
    ]
    (OUT/"FINAL_REVIEWER_CLEARANCE.md").write_text("\n".join(lines))

def main():
    validate_inputs()
    base=import_base_module()
    print("Device:",base.CFG.device)

    tu=load_bundle(base,"tu")
    msu=load_bundle(base,"msu")
    tu_split=base.group_split(tu,PRIMARY_SPLIT_SEED)
    msu_split=base.group_split(msu,PRIMARY_SPLIT_SEED)

    # 1) Frozen posterior coupling audit
    tu_post=posterior_gap_audit(base,tu,tu_split)
    msu_post=posterior_gap_audit(base,msu,msu_split)

    # 2) MSU raw hygiene + corrected HGB sanity
    raw=load_msu_raw_no_impute(base)
    verify_msu_alignment(msu,raw)
    bad,dup=msu_hygiene_audit(base,msu,msu_split,raw)
    msu_hgb,Xcorr=msu_hgb_sanity(msu,msu_split,raw)

    # 3) Neural-vs-HGB single modality
    tu_single=single_modality_diagnostic(base,tu,tu_split)
    msu_single=single_modality_diagnostic(base,msu,msu_split)

    # 4) M1 control: classifier and policy never share training rows. Prefer group-disjoint when feasible.
    disjoint={}
    if RUN_DISJOINT_DQN_CONTROL:
        disjoint[tu.name]=disjoint_control_for_dataset(base,tu,tu_split,None)
        disjoint[msu.name]=disjoint_control_for_dataset(base,msu,msu_split,raw)

    # 5) If preprocessing correction materially changes HGB, automatically generate
    #    a corrected primary-MSU neural sensitivity result.
    cur=msu_hgb[(msu_hgb.protocol=="file_disjoint")&(msu_hgb.preprocessing=="current_pooled_median")].iloc[0]
    fix=msu_hgb[(msu_hgb.protocol=="file_disjoint")&(msu_hgb.preprocessing=="train_only_median")].iloc[0]
    hgb_delta=float(fix.macro_f1-cur.macro_f1)
    corrected_primary=None
    if RUN_CORRECTED_PRIMARY_MSU_IF_NEEDED and abs(hgb_delta)>=MATERIAL_HGB_DELTA:
        corrected_primary=corrected_primary_msu_sensitivity(base,msu,msu_split,raw)

    results={
        "posterior":{tu.name:tu_post,msu.name:msu_post},
        "msu_bad":bad,"msu_dup":dup,"msu_hgb":msu_hgb,
        "single":{tu.name:tu_single,msu.name:msu_single},
        "disjoint":disjoint,
        "corrected_primary_msu":corrected_primary,
    }
    write_report(results)

    # compact machine-readable manifest
    manifest={
        "primary_split_seed":PRIMARY_SPLIT_SEED,
        "control_seeds":CONTROL_SEEDS,
        "dqn_lambda":LAMBDA,
        "dqn_episodes":DQN_EPISODES,
        "backbone_fraction":BACKBONE_FRACTION,
        "msu_hgb_delta_corrected_minus_current":hgb_delta,
        "outputs":sorted([p.name for p in OUT.iterdir() if p.is_file()]),
    }
    (OUT/"run_manifest.json").write_text(json.dumps(manifest,indent=2))

    zip_path=WORK_ROOT/"final_reviewer_clearance.zip"
    if zip_path.exists():zip_path.unlink()
    shutil.make_archive(str(zip_path.with_suffix("")),"zip",root_dir=OUT)

    print("\n"+"="*90)
    print("FINAL REVIEWER-CLEARANCE AUDIT COMPLETE")
    print("Output:",OUT)
    print("ZIP   :",zip_path)
    print("="*90)

if __name__=="__main__":
    main()





