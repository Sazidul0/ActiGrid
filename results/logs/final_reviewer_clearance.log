def set_seed(base, seed: int):
    base.CFG.seed = int(seed)
    if hasattr(base, "seed_everything"):
        base.seed_everything(int(seed))
    elif hasattr(base, "set_seed"):
        base.set_seed(int(seed))
    np.random.seed(int(seed))
    torch.manual_seed(int(seed))

def metric_dict(y, pred):
    y = np.asarray(y, int)
    pred = np.asarray(pred, int)
    return {
        "accuracy": float(accuracy_score(y, pred)),
        "balanced_accuracy": float(balanced_accuracy_score(y, pred)),
        "macro_f1": float(f1_score(y, pred, average="macro", zero_division=0)),
    }

def ece(probs, y, n_bins=15):
    probs = np.asarray(probs, float)
    y = np.asarray(y, int)
    conf = probs.max(1)
    pred = probs.argmax(1)
    edges = np.linspace(0, 1, n_bins + 1)
    out = 0.0
    for i, (lo, hi) in enumerate(zip(edges[:-1], edges[1:])):
        take = (conf >= lo) & (conf <= hi) if i == 0 else (conf > lo) & (conf <= hi)
        if take.any():
            out += take.mean() * abs((pred[take] == y[take]).mean() - conf[take].mean())
    return float(out)

def entropy(probs):
    p = np.clip(np.asarray(probs, float), 1e-12, 1.0)
    return -np.sum(p * np.log(p), axis=1)

def load_bundle(base, key: str):
